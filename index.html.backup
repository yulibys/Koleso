     <path d="M130 146L126 124M410 146L414 124M126 124H414"/>
    </g>
    <g class="p p-load">
     <path class="bg f-bone" d="M150 146C142 120 152 104 170 104C190 104 198 120 192 146Z"/>
     <path class="hf" d="M180 146C186 128 182 114 176 108C188 112 196 126 192 146Z"/>
     <path d="M166 108l4-8l4 8"/>
     <path class="bg f-ochre" d="M214 146C206 116 220 96 242 96C264 96 276 116 268 146Z"/>
     <path d="M238 100l4-9l4 9"/>
     <path class="bg f-clay" d="M300 146C290 130 292 112 310 108L314 92H326L330 108C348 112 350 130 340 146Z"/>
