  <figure class="stk" data-k=".08,.12,.24,.28" style="--cx:64%;--cy:8%;--cw:clamp(240px,26vw,400px);--dx:60vw;--dy:0;--cr:4deg;--sp:20deg"><img src="data:image/webp;base64," alt=""><figcaption>Норвегия, около 1900 года. Колёса уже со&nbsp;спицами</figcaption></figure>
