    </g>
    <g class="p p-mud"><path class="hx" d="M208 272C214 258 236 256 250 262C262 254 290 256 302 266C318 262 332 266 336 272Z"/></g>
    <g class="p p-wheel"><g class="rollaway"><g class="spin" data-cx="270" data-cy="224" data-r="48">
     <g transform="translate(270 224) scale(.6)"><circle class="bg f-wood" r="80"/><g data-fig="wheel"></g><path class="red th" d="M32-58l12 12M44-58L32-46"/></g>
    </g></g></g>
   </g>
  </g>
 </defs>
</svg>

<canvas class="fx" id="fx" aria-hidden="true"></canvas>
<button type="button" class="snd" id="sndBtn" aria-pressed="true" aria-label="Звук"><svg class="ill" viewBox="0 0 24 20" aria-hidden="true"><path d="M2 7h4l5-4v14l-5-4H2Z"/><path class="wv" d="M15 6c2 2 2 6 0 8M18 3c4 4 4 10 0 14"/><path class="x" d="M15 6l7 8M22 6l-7 8"/></svg><span class="st-l">звук вкл</span></button>

<!-- главное колесо: одно на весь лонгрид -->
<svg class="guide boil" id="guide" viewBox="-100 -100 200 200" aria-hidden="true">
 <defs><pattern id="hatchG" width="5" height="5" patternUnits="userSpaceOnUse" patternTransform="rotate(-38)"><line x1="0" y1="0" x2="0" y2="5" stroke="currentColor" stroke-width="1"/></pattern></defs>
 <ellipse id="gShadow" cx="0" cy="84" rx="70" ry="6"/>
 <clipPath id="gClip"><circle r="78"/></clipPath>
 <g id="gRot"><g id="gMorph"><path id="gBg"/><path id="gFill" fill-rule="evenodd"/><path id="gLine"/><path id="gThin"/></g><g id="gArt"><use href="#wheelArt"/></g><path id="gChalk" d="M30-60l14 14M44-60L30-46"/></g>
 <path id="gShade" clip-path="url(#gClip)" fill-rule="evenodd" d="M-100 -100H100V100H-100ZM-18 -102A86 86 0 1 1 -18 70A86 86 0 1 1 -18 -102Z"/>
</svg>

<main>
<!-- 1 · ВХОД -->
<section class="sc open silent" id="open" aria-labelledby="oH">
 <div class="stick frame" id="openStick">
  <div class="scenery silentart" data-kind="hero" aria-hidden="true"></div><div class="flick" aria-hidden="true"></div><div class="scratch" aria-hidden="true"><i></i><i></i><i></i></div>
  <h1 class="o-title" id="oH"><span class="o-t1 disp">Далеко собрались?</span><span class="o-t2 disp" aria-hidden="true">Ловите!</span><span class="o-t3 disp" aria-hidden="true">Не&nbsp;успели.</span></h1>
  <div class="cutflash" aria-hidden="true"></div>
  <div class="o-count" id="oCount" aria-live="off">
   <div class="cn-slot"><div class="cn-reel" id="cnReel">
    <div class="cn-face"><span class="cn-k">Сегодня</span><span class="cn-d" id="cntDate">17 октября 2026</span></div>
    <div class="cn-face"><span class="cn-k">Первое колесо</span><span class="cn-d">около 4000&nbsp;г. до&nbsp;н.&nbsp;э.</span></div>
   </div></div>
   <p class="cn-ex voice rise" data-k=".63,.67,.87,.9">Примерно тогда люди придумали колесо. Туда оно и&nbsp;укатилось.</p>
  </div>
  <figure class="stk" data-k=".6,.64,.86,.9" style="--cx:70%;--cy:62%;--cw:clamp(200px,22vw,340px);--dx:0;--dy:60vh;--cr:-8deg;--sp:-25deg"><img src="data:image/webp;base64," alt=""><figcaption>Оно самое. Городской музей Любляны</figcaption></figure>
  <div class="rew-fx" aria-hidden="true"><i></i><b>◀◀</b></div>
 </div>
</section>

<!-- 2 · ЛОВИТЕ! КАК ДОГНАТЬ? -->
<section class="sc open open2 silent" id="open2" aria-labelledby="pickH">
 <div class="stick frame" id="open2Stick">
  <div class="scenery silentart" data-kind="hero" aria-hidden="true"></div><div class="flick" aria-hidden="true"></div><div class="scratch" aria-hidden="true"><i></i><i></i><i></i></div>
  <h2 class="o-title"><span class="o-t1 disp" aria-hidden="true">Ловите!</span><span class="o-t2 disp" id="pickH">Как теперь его догнать?</span></h2>
  <button type="button" class="o-c o-opt tl" data-k=".34,.38" data-o="0">Побегу за ним</button>
  <button type="button" class="o-c o-opt tr" data-k=".42,.46" data-o="1">Возьму другое</button>
  <p class="o-say voice" id="say" aria-live="polite"></p>
  <svg class="runner ill boil" id="runner" viewBox="0 0 100 140" aria-hidden="true"><g class="walking"><use href="#tRunner"/></g></svg>
  <svg class="wheel2 ill boil" id="wheel2" viewBox="-100 -100 200 200" aria-hidden="true"><g data-fig="wheel"></g></svg>
  <p class="o-nudge voice" id="nudge" aria-live="polite">Сейчас вы, конечно, прокрутите дальше.</p>
 </div>
</section>

<!-- 3 · ИНТЕРТИТР + ПОЗЖЕ ФЛЕЙТЫ -->
<section class="sc later" id="later" aria-labelledby="ltH">
 <div class="stick frame" id="laterStick">
  <div class="scenery" data-kind="later" data-hy="640" data-hz=".7" data-color="1" aria-hidden="true"></div>
  <div class="lt-head rise" data-k="0,.001,.2,.26"><h2 class="disp" id="ltH">Колесо придумали позже флейты</h2></div>
  <figure class="stk" data-k=".5,.56,.7,.76" style="--cx:70%;--cy:10%;--cw:clamp(110px,10vw,170px);--dx:40vw;--dy:0;--cr:8deg;--sp:40deg"><img src="data:image/webp;base64," alt=""><figcaption>Флейта из&nbsp;пещеры Дивье Бабе. Или кость, которую погрыз медведь: учёные спорят</figcaption></figure>
  
  
  <figure class="collage" data-shape="blob" data-k=".21,.27,.36,.42" style="--cx:60%;--cy:8%;--cr:3deg;--dx:60vw;--dy:0;--cw:clamp(220px,26vw,400px)"><div class="ph"><img src="data:image/jpeg;base64," alt=""></div><figcaption>Пещера Ласко. Лошадей и&nbsp;быков рисовать уже умели. Колёс&nbsp;— ни&nbsp;одного</figcaption></figure>
  <div class="track" id="track" aria-label="Что придумали раньше колеса">
   <div class="line"></div>
   <div class="st draw" data-i="0"><svg class="ill boil" viewBox="0 0 200 160" aria-hidden="true"><path pathLength="1" class="f-bone" d="M150 22L44 146L40 152L47 149L156 28Z"/><path pathLength="1" d="M148 31l5-5"/><path pathLength="1" class="t" d="M152 26C180 10 190 60 160 70S110 90 130 120S170 150 150 158"/></svg><span class="nm">Игла</span><span class="wh">очень давно</span></div>
   <div class="st draw" data-i="1"><svg class="ill boil" viewBox="0 0 200 160" aria-hidden="true"><path pathLength="1" class="f-ochre" d="M30 150a70 16 0 1 0 140 0a70 16 0 1 0-140 0"/><path pathLength="1" d="M42 136a58 13 0 1 0 116 0a58 13 0 1 0-116 0"/><path pathLength="1" d="M54 122a46 11 0 1 0 92 0a46 11 0 1 0-92 0"/><path pathLength="1" d="M66 110a34 8 0 1 0 68 0a34 8 0 1 0-68 0"/><path pathLength="1" d="M134 110C150 90 140 60 168 40S190 20 186 10"/><path pathLength="1" class="t" d="M50 150l6-6M80 156l6-6M120 156l6-6M150 150l6-6M60 134l5-5M100 140l5-5M136 136l5-5"/></svg><span class="nm">Верёвка</span><span class="wh">тоже очень давно</span></div>
   <div class="st draw" data-i="2"><svg class="ill boil" viewBox="0 0 200 160" aria-hidden="true"><path pathLength="1" class="f-bone" d="M24 128L170 54L178 68L32 142Z"/><path pathLength="1" class="hf" d="M28 135L174 61L178 68L32 142Z"/><path pathLength="1" d="M70 112a4 4 0 1 0 1 0M96 99a4 4 0 1 0 1 0M122 86a4 4 0 1 0 1 0M148 73a4 4 0 1 0 1 0"/><path pathLength="1" class="t" d="M182 40c6-6 10-4 14-10M186 52c6-2 10 0 14-4"/></svg><span class="nm">Флейта</span><span class="wh">давно</span></div>
   <div class="st draw" data-i="3"><svg class="ill boil" viewBox="0 0 200 160" aria-hidden="true"><path pathLength="1" class="f-wood" d="M8 112C40 144 160 144 192 112L182 104C150 126 50 126 18 104Z"/><path pathLength="1" class="hf" d="M18 112C50 134 150 134 182 112L178 120C150 136 50 136 22 120Z"/><path pathLength="1" d="M120 40L80 150M74 140l-6 18 14-12"/><path pathLength="1" class="t" d="M0 152c20-6 40 6 60 0s40-6 60 0 40 6 60 0 20-6 20-6"/></svg><span class="nm">Лодка</span><span class="wh">позже. И&nbsp;мокро</span></div>
   <div class="st draw" data-i="4"><svg class="ill boil" viewBox="0 0 200 160" aria-hidden="true"><path class="f-clay" d="M70 106C58 80 72 58 88 50L112 50C128 58 142 80 130 106Z" stroke="none"/><path pathLength="1" d="M70 106C58 80 72 58 88 50L112 50C128 58 142 80 130 106"/><path pathLength="1" d="M84 50C80 44 82 40 86 38H114C118 40 120 44 116 50"/><path pathLength="1" class="hf" d="M112 50C128 58 142 80 130 106H116C124 84 120 62 112 50Z"/><path pathLength="1" class="f-wood" d="M30 110a70 12 0 1 0 140 0a70 12 0 1 0-140 0"/><path pathLength="1" d="M92 122V154M108 122V154M60 156H140"/><path pathLength="1" class="t" d="M150 90c10-8 22-8 30 2M156 100c8-6 16-6 22 0"/></svg><span class="nm">Гончарный круг</span><span class="wh">почти вчера</span></div>
   <div class="st draw" data-i="5"><svg class="ill boil" viewBox="0 0 200 160" aria-hidden="true"><path pathLength="1" class="f-wood2" d="M28 84H150V112H28Z"/><path pathLength="1" class="t" d="M28 98H150M70 84V112M110 84V112"/><path pathLength="1" d="M150 106L196 96"/><circle pathLength="1" class="f-wood" cx="89" cy="126" r="32"/><circle pathLength="1" cx="89" cy="126" r="26"/><path pathLength="1" d="M83 120h12v12h-12z"/><path pathLength="1" class="red" d="M106 108l8 8M114 108l-8 8"/></svg><span class="nm">Повозка</span><span class="wh">только что</span></div>
  </div>
  <p class="lt-end voice rise" data-k=".86,.9">Круг придумать легко. Трудно придумать то, что к&nbsp;нему прикручено.<span class="hand type" data-k=".9,.97">и&nbsp;кто его будет толкать</span></p>
  <div class="rip" data-rip=".07,.2" aria-hidden="false">
   <div class="half top"><div class="sheet"><div class="chalk"></div><svg class="orn" viewBox="0 0 100 100" preserveAspectRatio="none" aria-hidden="true"><path d="M6 14V6H14M86 6H94V14M94 86V94H86M14 94H6V86"/></svg><div class="scratch"><i></i><i></i><i></i></div><p class="tx voice">Колесо кажется самым первым изобретением человека.<span class="hand">Только кажется.</span></p></div><svg class="edge" viewBox="0 0 100 100" preserveAspectRatio="none"><polyline/></svg></div>
   <div class="half bot" aria-hidden="true"><div class="sheet"><div class="chalk"></div><svg class="orn" viewBox="0 0 100 100" preserveAspectRatio="none" aria-hidden="true"><path d="M6 14V6H14M86 6H94V14M94 86V94H86M14 94H6V86"/></svg><div class="scratch"><i></i><i></i><i></i></div><p class="tx voice">Колесо кажется самым первым изобретением человека.<span class="hand">Только кажется.</span></p></div><svg class="edge" viewBox="0 0 100 100" preserveAspectRatio="none"><polyline/></svg></div>
  </div>
 </div>
</section>

<section class="sc pscreen" id="ps1">
 <div class="stick">
  <div class="ps-photo" style="background-image:url(data:image/jpeg;base64,)"></div>
  <svg class="ps-cut" viewBox="0 0 100 100" preserveAspectRatio="none" aria-hidden="true"><path d="M-40 0H62L60 9L66 14L58 22L63 31L55 38L61 47L52 56L57 64L49 73L54 81L46 90L50 100H-40Z"/></svg>
  <p class="ps-big disp rise" data-k=".08,.2"><span>Пять тысяч лет</span><span>в&nbsp;болоте</span></p>
  <p class="ps-small voice rise" data-k=".22,.32">Торф не&nbsp;пускает воздух. Без воздуха дерево не&nbsp;гниёт. Оно просто ждёт.</p>
 </div>
</section>

<!-- 4 · БОЛОТО -->
<section class="sc swamp" id="swamp" aria-labelledby="swH">
 <div class="stick frame">
  <div class="strata" id="strata" aria-hidden="true"><svg class="ill" id="strataSvg" viewBox="0 0 1440 2600" preserveAspectRatio="none"></svg></div>
  <div class="bubbles" aria-hidden="true" id="bubbles"></div>
  
  
  <figure class="collage" data-shape="oval" data-k=".2,.26,.34,.38" style="--cx:52%;--cy:50%;--cr:-3deg;--dx:60vw;--dy:20vh;--cw:clamp(240px,30vw,460px)"><div class="ph"><img src="data:image/jpeg;base64," alt="" loading="lazy"></div><figcaption>Свайные посёлки на&nbsp;Люблянском болоте. Так их&nbsp;представлял художник Август Грос</figcaption></figure>
  
  
  
  <p class="sw-t l sw-big rise" style="top:14%" data-k=".02,.06,.16,.2" id="swH">Болото<small class="voice">Любляна, 2002&nbsp;год</small></p>
  <p class="sw-note hand type" style="right:var(--gut);top:30%" data-k=".07,.13,.16,.2">осторожно, тут топко</p>
  <p class="sw-t l voice rise" style="top:28%" data-k=".5,.54,.62,.66">Пять тысяч лет. В&nbsp;полной тишине.<small class="hand" style="color:var(--red2);font-size:.7em">буль</small></p>
  <figure class="stk" data-k=".74,.8,.92,.97" style="--cx:6%;--cy:58%;--cw:clamp(220px,24vw,360px);--dx:0;--dy:60vh;--cr:6deg;--sp:30deg"><img src="data:image/webp;base64," alt=""></figure>
  <p class="sw-t l sw-big rise" style="top:12%" data-k=".7,.74">И&nbsp;вдруг&nbsp;— тук.</p>
  <p class="sw-t r voice rise" style="top:72%" data-k=".82,.86">Колесо. А&nbsp;рядом с&nbsp;ним&nbsp;— ось.</p>
  <svg class="ill boil draw" id="swAxle" style="position:absolute;z-index:5;left:50%;top:84%;width:min(70vw,640px);transform:translateX(-50%);color:var(--cream)" viewBox="0 0 640 40" data-k=".84,.92" aria-hidden="true"><path pathLength="1" d="M10 12H630V28H10Z"/><path pathLength="1" class="t" d="M40 12l-4 16M120 12l-4 16M240 12l-4 16M400 12l-4 16M560 12l-4 16"/><path pathLength="1" d="M4 10h14v20H4zM622 10h14v20h-14z"/></svg>
 </div>
</section>

<!-- 5 · НАХОДКА: таблица -->
<section class="sc find paper" id="find" aria-labelledby="fH">
 <div class="stick frame">
  <div class="tape" aria-hidden="true"><span>Не подмажешь — не поедешь · Кто везёт, на том и едут · Тише едешь — дальше будешь · Не подмажешь — не поедешь · Кто везёт, на том и едут · Тише едешь — дальше будешь · Не подмажешь — не поедешь · Кто везёт, на том и едут · Тише едешь — дальше будешь ·</span></div>
  
  <div class="plate">
   <div class="plate-fig">
    <div class="slot" id="plateSlot">
     <svg class="callouts ill draw" viewBox="-100 -100 200 200" data-k=".1,.4" aria-hidden="true">
      <path pathLength="1" class="t" d="M-80 96H80M-80 90V102M80 90V102"/>
      <path pathLength="1" class="t" d="M9 9L60 70H96"/>
     </svg>
     <span class="hand" style="position:absolute;left:50%;top:103%;transform:translateX(-50%);color:var(--red);font-size:clamp(16px,1vw + 10px,22px);white-space:nowrap">72&nbsp;см</span>
     <span class="hand" style="position:absolute;left:96%;top:82%;color:var(--red);font-size:clamp(14px,.8vw + 10px,20px);white-space:nowrap">квадратная дырка</span>
    </div>
   </div>
   <div class="plate-txt">
    <h2 class="disp" id="fH">Ему больше пяти тысяч лет, и&nbsp;его нашли в&nbsp;болоте</h2>
    <p class="hand type" data-k=".04,.14">ох, этот запах</p>
    <ul class="specs">
     <li class="rise" data-k=".12,.18"><span class="k">размер</span><div><b>72&nbsp;см</b></div></li>
     <li class="rise" data-k=".22,.28"><span class="k">материал</span><div><b>Ясень</b></div></li>
     <li class="rise" data-k=".32,.38"><span class="k">ось</span><div><b>Дуб, 124&nbsp;см</b></div></li>
     <li class="rise" data-k=".42,.48"><span class="k">крепление</span><div><b>Квадратная дырка</b><span>Ось крутилась вместе с&nbsp;колесом. Поворачивать на&nbsp;такой телеге было мучением.</span></div></li>
    </ul>
   </div>
  </div>
  <div class="tape rev" aria-hidden="true"><span>Пятое колесо в телеге · Вставлять палки в колёса · Дорогу осилит идущий · Баба с возу — кобыле легче · Пятое колесо в телеге · Вставлять палки в колёса · Дорогу осилит идущий · Баба с возу — кобыле легче ·</span></div>
 </div>
</section>

<section class="sc pscreen" id="ps2">
 <div class="stick">
  <div class="ps-photo" style="background-image:url(data:image/jpeg;base64,)"></div>
  <svg class="ps-cut" viewBox="0 0 100 100" preserveAspectRatio="none" aria-hidden="true"><path d="M-40 0H62L60 9L66 14L58 22L63 31L55 38L61 47L52 56L57 64L49 73L54 81L46 90L50 100H-40Z"/></svg>
  <p class="ps-big disp rise" data-k=".08,.2"><span>Колесо есть.</span><span>Ехать не&nbsp;на&nbsp;чем.</span></p>
  <p class="ps-small voice rise" data-k=".22,.32">Две ясеневые доски и&nbsp;дубовая ось. Чтобы сдвинуться с&nbsp;места, нужно ещё кое-что.</p>
 </div>
</section>

<!-- 6 · ИНТЕРТИТР + ОДНОГО КОЛЕСА МАЛО -->
<section class="sc eq" id="eq" aria-labelledby="eqH">
 <div class="stick frame">
  <div class="eq-head rise" data-k=".16,.2,.6,.64"><h2 class="disp" id="eqH">Одного колеса мало</h2><p class="voice">Повозка&nbsp;— это</p></div>
  <div class="eq-row" id="eqRow">
   <div class="term" data-t="wheel"><div class="pic" id="eqSlot"></div><span class="w rise" data-k=".22,.26">колесо</span></div>
   <div class="term pop" data-k=".27,.31"><span class="plus">+</span><div class="pic"><svg class="ill boil" viewBox="0 0 200 200" aria-hidden="true"><path class="f-wood" d="M30 92H170V108H30Z" stroke="none"/><path class="hf" d="M30 92H170V108H30Z"/><path d="M30 92H170M30 108H170"/><ellipse cx="30" cy="100" rx="6" ry="8"/><ellipse cx="170" cy="100" rx="6" ry="8"/><path d="M18 90h12v20H18zM170 90h12v20h-12z"/></svg></div><span class="w">ось</span></div>
   <div class="term pop" data-k=".32,.36"><span class="plus">+</span><div class="pic"><svg class="ill boil" viewBox="0 0 200 200" aria-hidden="true"><path class="hf" d="M24 140H176V128H24Z"/><rect class="bg f-wood2" x="20" y="80" width="160" height="60"/><path class="t" d="M20 100H180M20 120H180M70 80V140M130 80V140"/><path d="M28 80L24 56M172 80L176 56M24 56H176"/></svg></div><span class="w">кузов</span></div>
   <div class="term pop" data-k=".37,.41"><span class="plus">+</span><div class="pic"><svg class="ill boil" viewBox="0 0 200 200" aria-hidden="true"><path class="bg f-bone" d="M30 150C22 116 34 92 58 92C82 92 92 116 86 150Z"/><path class="hf" d="M70 150C76 124 72 104 66 96C80 102 90 120 86 150Z"/><path d="M54 96l4-10 4 10"/><path class="bg f-ochre" d="M96 150C86 108 104 80 132 80C160 80 174 108 166 150Z"/><path d="M128 84l4-11 4 11"/><path class="t" d="M110 120c10-4 30-4 40 0"/></svg></div><span class="w">груз</span></div>
   <div class="term pop" data-k=".42,.46"><span class="plus">+</span><div class="pic"><svg class="ill boil" viewBox="-6 -20 232 170" aria-hidden="true"><use href="#tOx"/></svg></div><span class="w">бык</span></div>
   <div class="term pop" data-k=".47,.51"><span class="plus">+</span><div class="pic"><svg class="ill boil" viewBox="0 0 200 200" aria-hidden="true"><path class="f-road" d="M86 40L20 170H180L114 40Z" stroke="none"/><path d="M86 40L20 170M114 40L180 170"/><path class="t" d="M100 50V62M100 76V92M100 108V128M100 146V170"/><path class="t" d="M60 120l-8 14M146 120l8 14M70 90l-5 9"/><path d="M0 170H200"/></svg></div><span class="w">дорога</span></div>
  </div>
  <svg class="eq-cart ill boil fade" id="eqCart" viewBox="-60 60 920 260" data-k=".62,.7" aria-hidden="true"><g class="noWheel"><use href="#tCart"/></g><circle id="eqWheel" cx="270" cy="224" r="48" fill="none" stroke="none"/></svg>
  <figure class="stk" data-k=".66,.72" style="--cx:3%;--cy:10%;--cw:clamp(220px,24vw,380px);--dx:-60vw;--dy:0;--cr:-5deg;--sp:-30deg"><img src="data:image/webp;base64," alt=""><figcaption>Кувшин из&nbsp;Броночице. На&nbsp;нём, возможно, самый старый рисунок повозки</figcaption></figure>
  
  
  <div class="eq-sum"><p class="disp rise" data-k=".7,.75">Колесо никогда не&nbsp;едет одно</p><span class="hand type" data-k=".78,.86">одного не&nbsp;хватает</span></div>
  <div class="rip" data-rip=".06,.17">
   <div class="half top"><div class="sheet"><div class="chalk"></div><svg class="orn" viewBox="0 0 100 100" preserveAspectRatio="none" aria-hidden="true"><path d="M6 14V6H14M86 6H94V14M94 86V94H86M14 94H6V86"/></svg><div class="scratch"><i></i><i></i><i></i></div><p class="tx voice">Пять тысяч лет колесо пролежало в&nbsp;болоте и&nbsp;ни&nbsp;разу никуда не&nbsp;поехало.<span class="hand">Без всего остального колесо&nbsp;— просто круглая доска.</span></p></div><svg class="edge" viewBox="0 0 100 100" preserveAspectRatio="none"><polyline/></svg></div>
   <div class="half bot" aria-hidden="true"><div class="sheet"><div class="chalk"></div><svg class="orn" viewBox="0 0 100 100" preserveAspectRatio="none" aria-hidden="true"><path d="M6 14V6H14M86 6H94V14M94 86V94H86M14 94H6V86"/></svg><div class="scratch"><i></i><i></i><i></i></div><p class="tx voice">Пять тысяч лет колесо пролежало в&nbsp;болоте и&nbsp;ни&nbsp;разу никуда не&nbsp;поехало.<span class="hand">Без всего остального колесо&nbsp;— просто круглая доска.</span></p></div><svg class="edge" viewBox="0 0 100 100" preserveAspectRatio="none"><polyline/></svg></div>
  </div>
 </div>
</section>

<!-- 7 · СОБЕРИТЕ СВОЮ ПОВОЗКУ -->
