  <figure class="collage" data-shape="blob2" data-k=".73,.77,.9,.93" style="--cx:5%;--cy:8%;--cr:-5deg;--dx:-60vw;--dy:0"><div class="ph"><img src="data:image/jpeg;base64," alt="" loading="lazy"></div><figcaption>Омнибус, Париж, 1928. Тоже опаздывал</figcaption></figure>
  
  
  
  
