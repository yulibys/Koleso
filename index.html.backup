0S420 110 520 124" pathLength="1"/><path class="wind t" style="--d:1.6s" d="M-40 150C60 136 140 162 240 150S420 140 520 154" pathLength="1"/><path class="wind t" style="--d:3.2s" d="M-40 95C60 81 140 107 240 95S420 85 520 99" pathLength="1"/></g></svg><svg class="ill boil" id="cart" viewBox="-40 60 880 250" role="img" aria-label="Повозка, которую вы собираете"><g class="labcart"></g></svg></div>
  <div class="lab-say" aria-live="polite"><p class="t" id="labTitle">Здесь пока пусто</p><p class="l voice" id="labLine">Начните с&nbsp;колеса. С&nbsp;чего&nbsp;же ещё.</p></div>
  <ul class="parts" id="parts">
   <li><button type="button" class="part" data-p="wheel">Колесо</button></li>
   <li><button type="button" class="part" data-p="axle">Ось</button></li>
   <li><button type="button" class="part" data-p="body">Кузов</button></li>
   <li><button type="button" class="part" data-p="load">Груз</button></li>
   <li><button type="button" class="part" data-p="ox">Бык</button></li>
   <li><button type="button" class="part" data-p="road">Дорога</button></li>
  </ul>
 </div>
</section>

<!-- 7б · НАГАСЕНА, МИЛИНДА И САНСАРА -->
<section class="sc nag" id="nag" aria-labelledby="nagH">
 <div class="stick frame">
  <div class="scenery" data-kind="nag" data-hy="640" data-color="1" data-anchor="nagSvg:.944" aria-hidden="true"></div>
  <div class="nag-q"><p class="voice rise" id="nagH" data-k=".02,.07,.6,.64">Больше двух тысяч лет назад монах Нагасена спросил царя Милинду: колесо&nbsp;— это колесница? А&nbsp;ось? А&nbsp;кузов?</p></div>
  <div class="nag-stage"><svg class="ill boil" viewBox="0 60 1000 360" id="nagSvg" aria-hidden="true">
   <g class="fade" data-k=".0,.04,.7,.76">
    <path class="bg f-ochre" d="M96 400C92 300 100 230 130 196C160 230 170 300 166 400Z"/><path class="hf" d="M130 196C160 230 170 300 166 400H140C146 320 142 250 130 196Z"/>
    <path d="M110 214L160 330M150 240L210 226L236 214"/><circle class="bg f-bone" cx="130" cy="172" r="22"/><path class="t" d="M120 176h4M136 176h4M124 186c4 3 8 3 12 0"/>
    <path class="bg f-teal" d="M820 400C820 300 836 220 870 186C904 220 922 300 922 400Z"/><path class="hx" d="M870 186C904 220 922 300 922 400H890C896 300 886 230 870 186Z"/>
    <path d="M840 262C860 250 880 250 900 262"/><circle class="bg f-bone" cx="870" cy="160" r="22"/><path class="f-gold" d="M848 142L852 118L862 132L870 112L878 132L888 118L892 142Z"/><path d="M856 172C858 196 882 196 884 172M860 160h4M876 160h4"/>
    <path class="t" d="M0 402H1000"/>
   </g>
   <text class="nag-word" x="500" y="150" text-anchor="middle" id="nagWord">колесница</text>
   <g class="np" data-i="1"><path class="f-wood" d="M372 334H548V344H372Z" stroke="none"/><path class="hf" d="M372 334H548V344H372Z"/><path d="M372 334H548V344H372Z"/><text class="lbl-no" x="560" y="370">ось? нет</text></g>
   <g class="np" data-i="2"><path class="bg f-wood2" d="M360 330C356 280 380 248 420 240L520 240C534 240 540 252 532 272L512 330Z"/><path class="hf" d="M370 326C368 290 386 262 414 254L420 326Z"/><path d="M390 240C400 226 440 222 470 228"/><text class="lbl-no" x="440" y="216">кузов? нет</text></g>
   <g class="np" data-i="3"><path d="M520 326L760 318M752 300L768 336M740 306H780"/><text class="lbl-no" x="640" y="300">дышло? нет</text></g>
   <text class="lbl-no np-w" x="300" y="250" id="nagNo0">колесо? нет</text>
   <circle id="nagSlot" cx="430" cy="340" r="62" fill="none" stroke="none"/>
  </svg></div>
  <div class="nag-end"><p class="voice rise" data-k=".6,.66">Нет, нет и&nbsp;нет. «Колесница»&nbsp;— только имя для того, что собрано. И&nbsp;«я», говорил монах, тоже.</p></div>
 </div>
</section>

<section class="sc pscreen" id="ps3">
 <div class="stick">
  <div class="ps-photo" style="background-image:url(data:image/jpeg;base64,)"></div>
  <svg class="ps-cut" viewBox="0 0 100 100" preserveAspectRatio="none" aria-hidden="true"><path d="M-40 0H62L60 9L66 14L58 22L63 31L55 38L61 47L52 56L57 64L49 73L54 81L46 90L50 100H-40Z"/></svg>
  <p class="ps-big disp rise" data-k=".08,.2"><span>А&nbsp;потом</span><span>поехали</span></p>
  <p class="ps-small voice rise" data-k=".22,.32">Колесо нашло ось, ось&nbsp;— кузов, кузов&nbsp;— быка. Остановиться было уже нельзя.</p>
 </div>
</section>

<!-- 8 · ДАЛЬШЕ ПОЕХАЛИ: парад повозок -->
<section class="sc parade" id="parade" aria-label="Парад повозок">
 <div class="stick frame">
  <div class="scenery wide" data-kind="parade" data-color="1" data-wide="3" data-hz=".74" aria-hidden="true"></div>
  <div class="road" aria-hidden="true"><svg class="ill boil" viewBox="0 0 1440 60" preserveAspectRatio="none"><path class="ns" d="M0 30C300 33 700 27 1000 31S1300 29 1440 30"/><path class="ns t road-dash" id="prDash" d="M0 44H1440" stroke-dasharray="30 22"/></svg></div>
  <div class="veh" id="v0" style="--w:clamp(340px,62vw,980px)"><svg class="ill boil" viewBox="-40 60 880 230" aria-hidden="true"><g class="walking"><use href="#tCart"/></g></svg><div class="cap"><b>Телега</b><span class="voice">Медленно, зато верно.</span></div></div>
  <div class="veh" id="v1" style="--w:clamp(320px,54vw,860px)"><svg class="ill boil" viewBox="0 40 700 250" aria-hidden="true"><g class="walking" id="chariot">
    <g transform="translate(430 134)"><use href="#tHorse"/></g>
    <path d="M250 198L596 196"/>
    <path class="bg f-ochre" d="M120 200C118 160 140 130 180 124L250 124C262 124 268 134 262 150L244 200Z"/>
    <path class="hf" d="M130 196C128 166 146 140 176 134L180 196Z"/>
    <path d="M150 124C160 110 200 108 230 112"/>
    <circle class="bg f-bone" cx="205" cy="76" r="10"/><path d="M205 86L210 124M207 96L250 110L632 160"/>
    <g class="spin" data-cx="200" data-cy="218" data-r="54"><circle class="bg f-wood" cx="200" cy="218" r="54"/><circle cx="200" cy="218" r="47"/><circle cx="200" cy="218" r="8"/><path d="M200 210V171M200 226V265M207 214L241 195M193 222L159 241M207 222L241 241M193 214L159 195"/></g>
