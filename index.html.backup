 </div>
 <p class="credits-photo" id="photoCredits">Фотографии и рисунки — Викисклад: <a href="https://commons.wikimedia.org/wiki/File:Fl%C3%BBte_pal%C3%A9olithique_(mus%C3%A9e_national_de_Slov%C3%A9nie,_Ljubljana)_(9420310527).jpg">Flûte paléolithique (musée national de Slovénie, Ljubljana) </a> (dalbera from Paris, France, CC BY 2.0); <a href="https://commons.wikimedia.org/wiki/File:Ljubljana_Marshes_Wheel_with_axle_(oldest_wooden_wheel_yet_discovered).jpg">Ljubljana Marshes Wheel with axle (oldest wooden wheel yet d</a> (Petar Milošević, CC BY-SA 4.0); <a href="https://commons.wikimedia.org/wiki/File:0854_Ein_Krug_aus_Bronocice,_3.550_v._Chr..JPG">0854 Ein Krug aus Bronocice, 3.550 v. Chr.</a> (Silar, CC BY-SA 3.0); <a href="https://commons.wikimedia.org/wiki/File:Bullock_cart,_Sogndal,_ca._1898-1900.jpg">Bullock cart, Sogndal, ca. 1898-1900</a> (Nils Olsen Reppen / Fylkesarkivet i Sogn og Fjordane, No restrictions); <a href="https://commons.wikimedia.org/wiki/File:Standard_of_Ur_-_War.jpg">Standard of Ur - War</a> (автор неизвестен, Public domain); <a href="https://commons.wikimedia.org/wiki/File:Laufmaschine_des_Karl_Friedrich_Drais_1817_(vorne_rechts),_gefertigt_durch_Johann_Frey.jpg">Laufmaschine des Karl Friedrich Drais 1817 (vorne rechts), g</a> (User:Mattes, Public domain); <a href="https://commons.wikimedia.org/wiki/File:Omnibus_Saint-Ouen_-_Bastille_-_Mi-Car%C3%AAme_%C3%A0_Paris_1928.jpg">Omnibus Saint-Ouen - Bastille - Mi-Carême à Paris 1928</a> (Agence de presse Meurisse, Public domain); <a href="https://commons.wikimedia.org/wiki/File:Ferris-wheel.jpg">Ferris-wheel</a> (автор неизвестен, Public domain); <a href="https://commons.wikimedia.org/wiki/File:Dharmachakra_on_Pillar_-_South_Face_-_West_Pillar_-_South_Gateway_-_Stupa_1_-_Sanchi_Hill_2013-02-21_4355.JPG">Dharmachakra on Pillar - South Face - West Pillar - South Ga</a> (Biswarup Ganguly, CC BY 3.0); <a href="https://commons.wikimedia.org/wiki/File:Lascaux_painting.jpg">Lascaux painting</a> (EU, Public domain); <a href="https://commons.wikimedia.org/wiki/File:Vintage_steering_wheel_(Unsplash).jpg">Vintage steering wheel (Unsplash)</a> (Dahan Remy grafikoweb, CC0); <a href="https://commons.wikimedia.org/wiki/File:Idealbild_des_Laibacher_Beckens_-_Pfahlbautenzeit_(Grosz).jpg">Idealbild des Laibacher Beckens - Pfahlbautenzeit (Grosz)</a> (August Ignaz Grosz, Public domain); <a href="https://commons.wikimedia.org/wiki/File:Native_of_Palestine_working_with_an_ox_and_an_ass,_Holy_Land-LCCN2002725074.jpg">Native of Palestine working with an ox and an ass, Holy Land</a> (автор неизвестен, Public domain); <a href="https://commons.wikimedia.org/wiki/File:Patent-Motorwagen_Nr.1_Benz_2.jpg">Patent-Motorwagen Nr.1 Benz 2</a> (DaimlerChrysler AG, CC BY-SA 3.0); <a href="https://commons.wikimedia.org/wiki/File:Idealbild_des_Laibacher_Beckens_-_Pfahlbautenzeit_(Grosz).jpg">Idealbild des Laibacher Beckens - Pfahlbautenzeit (Grosz)</a> (August Ignaz Grosz, Public domain); <a href="https://commons.wikimedia.org/wiki/File:Ljubljana_Marshes_Wheel_with_axle_(oldest_wooden_wheel_yet_discovered).jpg">Ljubljana Marshes Wheel with axle (oldest wooden wheel yet d</a> (Petar Milošević, CC BY-SA 4.0); <a href="https://commons.wikimedia.org/wiki/File:Original_Ferris_wheel_in_Lincoln_park,_Chicago_(edit).jpg">Original Ferris wheel in Lincoln park, Chicago (edit)</a> (UnknownReproduction: User:Victorgrigas @ Wikimedia Commons, Public domain); <a href="https://commons.wikimedia.org/wiki/File:Bullock_cart,_Sogndal,_ca._1898-1900.jpg">Bullock cart, Sogndal, ca. 1898-1900</a> (Nils Olsen Reppen / Fylkesarkivet i Sogn og Fjordane, No restrictions).</p>
</footer>
</main>

<script>
/* Пейзажи-гравюры: холмы, дорога, деревья, изба, мельница, верстовой столб. viewBox 0 0 W 900, горизонт на y=600 */
window.SCENERY=(function(){
let seed=1;const rnd=()=>{seed=(seed*16807)%2147483647;return seed/2147483647};
const f=n=>Math.round(n*10)/10;
let uid=0;
function wave(x0,x1,y,amp,step=40){let d=`M${x0} ${y}`;for(let x=x0+step;x<=x1;x+=step)d+=`L${x} ${f(y+(rnd()-.5)*amp)}`;return d}
function hill(x0,x1,base,top,cls,fill){const mid=(x0+x1)/2,w=x1-x0;const d=`M${x0} ${base}C${f(x0+w*.2)} ${f(top+ (base-top)*.4)} ${f(mid-w*.18)} ${top} ${f(mid)} ${top}S${f(x1-w*.2)} ${f(top+(base-top)*.45)} ${x1} ${base}`;
  return `<path class="${fill||''}" d="${d}Z" stroke="none"/><path class="hf" d="${d}Z" opacity="${cls||.35}" stroke="none"/><path d="${d}"/>`}
function cloud(x,y,s,c){let d=`M${x} ${y}`;let cx=x;const n=4+Math.floor(rnd()*3);for(let i=0;i<n;i++){const r=f(s*(.5+rnd()*.5));d+=`a${r} ${r} 0 0 1 ${f(r*1.6)} 0`;cx+=r*1.6}d+=`Z`;
  return `<path class="${c?'f-bone':'bg'}" d="${d}"/><path class="hf" d="M${x} ${y}H${f(cx)}V${f(y-s*.35)}H${x}Z" opacity=".5" stroke="none"/><path d="${d}"/>`}
function oak(x,y,h,c){const r=h*.38,cy=y-h*.66;let d='';const n=14;for(let i=0;i<=n;i++){const a=i/n*Math.PI*2-Math.PI/2,rr=r*(.88+rnd()*.2),px=x+Math.cos(a)*rr*1.12,py=cy+Math.sin(a)*rr*.92;
    if(!i)d=`M${f(px)} ${f(py)}`;else{const a2=a-Math.PI/n,qx=x+Math.cos(a2)*rr*1.35,qy=cy+Math.sin(a2)*rr*1.12;d+=`Q${f(qx)} ${f(qy)} ${f(px)} ${f(py)}`}}
  const id='cl'+(uid++);
  return `<path class="${c?'f-wood':'bg'}" d="M${f(x-h*.05)} ${y}C${f(x-h*.04)} ${f(y-h*.2)} ${f(x-h*.06)} ${f(y-h*.36)} ${f(x-h*.02)} ${f(y-h*.46)}L${f(x+h*.03)} ${f(y-h*.46)}C${f(x+h*.06)} ${f(y-h*.3)} ${f(x+h*.05)} ${f(y-h*.16)} ${f(x+h*.07)} ${y}Z"/>
   <clipPath id="${id}"><path d="${d}Z"/></clipPath><path class="${c?'f-moss':'bg'}" d="${d}Z"/><g clip-path="url(#${id})"><circle class="hf" cx="${f(x+r*.55)}" cy="${f(cy+r*.45)}" r="${f(r*1.05)}" opacity=".75" stroke="none"/></g><path d="${d}Z"/>`}
function poplar(x,y,h,c){const w=h*.13;const d=`M${f(x)} ${f(y-h)}C${f(x+w)} ${f(y-h*.75)} ${f(x+w*1.1)} ${f(y-h*.3)} ${f(x+w*.4)} ${f(y-h*.12)}L${f(x-w*.4)} ${f(y-h*.12)}C${f(x-w*1.1)} ${f(y-h*.3)} ${f(x-w)} ${f(y-h*.75)} ${f(x)} ${f(y-h)}Z`;
  return `<path class="${c?'f-moss2':'bg'}" d="${d}"/><path class="t" d="M${f(x)} ${f(y-h*.9)}V${y}"/><path d="${d}"/><path class="t" d="M${f(x+w*.3)} ${f(y-h*.7)}l${f(w*.4)} 6M${f(x+w*.4)} ${f(y-h*.5)}l${f(w*.5)} 6M${f(x-w*.3)} ${f(y-h*.6)}l${f(-w*.4)} 6M${f(x-w*.4)} ${f(y-h*.36)}l${f(-w*.5)} 6"/>`}
function bush(x,y,s,c){let d=`M${f(x-s)} ${y}`;let cx=x-s;while(cx<x+s){const r=s*(.25+rnd()*.2);d+=`a${f(r)} ${f(r)} 0 0 1 ${f(r*2)} 0`;cx+=r*2}d+='Z';return `<path class="${c?'f-moss':'bg'}" d="${d}"/><path class="hf" d="${d}" opacity=".4" stroke="none"/><path d="${d}"/>`}
function hut(x,y,s,c){const w=s,h=s*.6;return `<path class="${c?'f-wood2':'bg'}" d="M${x} ${y}V${f(y-h)}H${f(x+w)}V${y}Z"/><path class="t" d="M${x} ${f(y-h*.33)}H${f(x+w)}M${x} ${f(y-h*.66)}H${f(x+w)}"/><path d="M${x} ${y}V${f(y-h)}H${f(x+w)}V${y}Z"/>
  <path class="${c?'f-ochre':'bg'}" d="M${f(x-s*.12)} ${f(y-h)}L${f(x+w*.5)} ${f(y-h-s*.55)}L${f(x+w+s*.12)} ${f(y-h)}Z"/><path class="hf" d="M${f(x-s*.12)} ${f(y-h)}L${f(x+w*.5)} ${f(y-h-s*.55)}L${f(x+w+s*.12)} ${f(y-h)}Z" opacity=".6" stroke="none"/><path d="M${f(x-s*.12)} ${f(y-h)}L${f(x+w*.5)} ${f(y-h-s*.55)}L${f(x+w+s*.12)} ${f(y-h)}Z"/>
  <path class="${c?'f-dark':'bg'}" d="M${f(x+w*.38)} ${y}V${f(y-h*.6)}H${f(x+w*.62)}V${y}Z"/><path d="M${f(x+w*.38)} ${y}V${f(y-h*.6)}H${f(x+w*.62)}V${y}M${f(x+w*.72)} ${f(y-h*.7)}h${f(w*.18)}v${f(h*.22)}h${f(-w*.18)}Z"/>
  <path d="M${f(x+w*.72)} ${f(y-h-s*.2)}v${f(-s*.3)}h${f(s*.1)}v${f(s*.2)}"/><g class="smoke"><path class="t" d="M${f(x+w*.77)} ${f(y-h-s*.55)}c-10 -14 14 -22 0 -38s12 -22 4 -40"/><path class="t" d="M${f(x+w*.8)} ${f(y-h-s*.7)}c12 -12 -8 -22 6 -36"/></g>`}
function mill(x,y,s,c){const h=s;return `<path class="${c?'f-wood2':'bg'}" d="M${f(x-s*.18)} ${y}L${f(x-s*.1)} ${f(y-h*.7)}H${f(x+s*.1)}L${f(x+s*.18)} ${y}Z"/><path class="hf" d="M${f(x)} ${y}L${f(x)} ${f(y-h*.7)}H${f(x+s*.1)}L${f(x+s*.18)} ${y}Z" opacity=".55" stroke="none"/><path d="M${f(x-s*.18)} ${y}L${f(x-s*.1)} ${f(y-h*.7)}H${f(x+s*.1)}L${f(x+s*.18)} ${y}ZM${f(x-s*.14)} ${f(y-h*.7)}L${f(x)} ${f(y-h*.86)}L${f(x+s*.14)} ${f(y-h*.7)}"/>
  <g class="blades" style="transform-origin:${f(x)}px ${f(y-h*.78)}px"><path d="M${f(x)} ${f(y-h*.78)}l${f(s*.5)} ${f(-s*.5)}M${f(x)} ${f(y-h*.78)}l${f(-s*.5)} ${f(s*.5)}M${f(x)} ${f(y-h*.78)}l${f(s*.5)} ${f(s*.5)}M${f(x)} ${f(y-h*.78)}l${f(-s*.5)} ${f(-s*.5)}"/><path class="t" d="M${f(x+s*.15)} ${f(y-h*.78-s*.15)}l${f(s*.28)} ${f(-s*.28)}l${f(s*.08)} ${f(s*.08)}l${f(-s*.28)} ${f(s*.28)}M${f(x-s*.15)} ${f(y-h*.78+s*.15)}l${f(-s*.28)} ${f(s*.28)}l${f(-s*.08)} ${f(-s*.08)}l${f(s*.28)} ${f(-s*.28)}M${f(x+s*.15)} ${f(y-h*.78+s*.15)}l${f(s*.28)} ${f(s*.28)}l${f(-s*.08)} ${f(s*.08)}l${f(-s*.28)} ${f(-s*.28)}M${f(x-s*.15)} ${f(y-h*.78-s*.15)}l${f(-s*.28)} ${f(-s*.28)}l${f(s*.08)} ${f(-s*.08)}l${f(s*.28)} ${f(s*.28)}"/><circle cx="${f(x)}" cy="${f(y-h*.78)}" r="${f(s*.04)}"/></g>`}
function milestone(x,y,h,c){const w=h*.12;let s=`<path class="bg" d="M${f(x-w)} ${y}V${f(y-h)}H${f(x+w)}V${y}Z"/>`;for(let i=0;i<6;i++)s+=`<path class="fill" d="M${f(x-w)} ${f(y-h+i*h/6+h/12)}L${f(x+w)} ${f(y-h+i*h/6)}V${f(y-h+i*h/6+h/14)}L${f(x-w)} ${f(y-h+i*h/6+h/12+h/14)}Z" opacity=".9"/>`;
  return s+`<path d="M${f(x-w)} ${y}V${f(y-h)}H${f(x+w)}V${y}Z"/><path class="${c?'f-bone':'bg'}" d="M${f(x-w*1.6)} ${f(y-h-h*.02)}h${f(w*3.2)}v${f(-h*.16)}h${f(-w*3.2)}Z"/><path d="M${f(x-w*1.6)} ${f(y-h-h*.02)}h${f(w*3.2)}v${f(-h*.16)}h${f(-w*3.2)}Z"/>`}
function grass(x,y,s){return `<path class="t" d="M${f(x)} ${f(y)}l${f(s*.2)} ${f(-s)}l${f(s*.15)} ${f(s)}l${f(s*.25)} ${f(-s*.8)}l${f(s*.1)} ${f(s*.8)}l${f(s*.25)} ${f(-s*.6)}l${f(s*.05)} ${f(s*.6)}"/>`}
function stone(x,y,s,c){return `<path class="${c?'f-bone2':'bg'}" d="M${f(x-s)} ${f(y)}C${f(x-s)} ${f(y-s*.8)} ${f(x+s)} ${f(y-s*.9)} ${f(x+s)} ${f(y)}Z"/><path class="hf" d="M${f(x)} ${f(y)}C${f(x+s*.4)} ${f(y-s*.5)} ${f(x+s)} ${f(y-s*.5)} ${f(x+s)} ${f(y)}Z" opacity=".7" stroke="none"/><path d="M${f(x-s)} ${f(y)}C${f(x-s)} ${f(y-s*.8)} ${f(x+s)} ${f(y-s*.9)} ${f(x+s)} ${f(y)}Z"/>`}
function birds(x,y,n){let s='';for(let i=0;i<n;i++){const bx=x+rnd()*160,by=y+rnd()*60,k=6+rnd()*6;s+=`<path class="t bird" d="M${f(bx)} ${f(by)}q${f(k*.5)} ${f(-k*.6)} ${f(k)} 0q${f(k*.5)} ${f(-k*.6)} ${f(k)} 0"/>`}return s}
function sun(x,y,r,c){let s=`<circle class="${c?'f-ochre':'bg'}" cx="${x}" cy="${y}" r="${r}"/><circle cx="${x}" cy="${y}" r="${r}"/>`;for(let i=0;i<16;i++){const a=i/16*Math.PI*2;s+=`<path class="t" d="M${f(x+Math.cos(a)*r*1.3)} ${f(y+Math.sin(a)*r*1.3)}L${f(x+Math.cos(a)*r*(i%2?1.6:1.9))} ${f(y+Math.sin(a)*r*(i%2?1.6:1.9))}"/>`}return s}
function road(cx,hz,bottom,wTop,wBot,c){const d=`M${cx-wTop} ${hz}L${cx-wBot} ${bottom}H${cx+wBot}L${cx+wTop} ${hz}Z`;let s=`<path class="${c?'f-road':'bg'}" d="${d}" stroke="none"/><path class="dot" d="${d}" opacity=".25" stroke="none"/><path d="M${cx-wTop} ${hz}L${cx-wBot} ${bottom}M${cx+wTop} ${hz}L${cx+wBot} ${bottom}"/>`;
  s+=`<path class="t" d="M${cx-wTop*.45} ${hz}L${f(cx-wBot*.45)} ${bottom}M${cx+wTop*.45} ${hz}L${f(cx+wBot*.45)} ${bottom}" stroke-dasharray="2 9"/>`;
  for(let i=0;i<26;i++){const t=Math.pow(rnd(),1.4),y=hz+(bottom-hz)*t,half=wTop+(wBot-wTop)*t,x=cx+(rnd()*2-1)*half*.9;s+=`<ellipse class="t" cx="${f(x)}" cy="${f(y)}" rx="${f(1+t*5)}" ry="${f(.6+t*2.5)}"/>`}return s}
function fence(cx,hz,bottom,side,c){let s='',prev=null;for(let i=0;i<9;i++){const t=Math.pow((i+1)/9,1.7),y=hz+(bottom-hz)*t,x=cx+side*(80+620*t),h=8+t*90;
    s+=`<path class="${c?'f-wood':'bg'}" d="M${f(x-2-t*4)} ${f(y)}V${f(y-h)}H${f(x+2+t*4)}V${f(y)}Z"/><path d="M${f(x-2-t*4)} ${f(y)}V${f(y-h)}H${f(x+2+t*4)}V${f(y)}Z"/>`;
    if(prev)s+=`<path class="t" d="M${f(prev[0])} ${f(prev[1]-prev[2]*.75)}L${f(x)} ${f(y-h*.75)}M${f(prev[0])} ${f(prev[1]-prev[2]*.4)}L${f(x)} ${f(y-h*.4)}"/>`;prev=[x,y,h]}return s}
function forest(x0,x1,y,c){let d=`M${x0} ${y}`;let x=x0;while(x<x1){const r=6+rnd()*10;d+=`a${f(r)} ${f(r*1.4)} 0 0 1 ${f(r*2)} 0`;x+=r*2}return `<path class="${c?'f-moss':'bg'}" d="${d}Z"/><path class="hx" d="${d}Z" opacity=".5" stroke="none"/><path class="t" d="${d}"/>`}
function hay(x,y,s,c){const d=`M${f(x-s)} ${y}C${f(x-s)} ${f(y-s*1.2)} ${f(x-s*.3)} ${f(y-s*1.7)} ${x} ${f(y-s*1.7)}C${f(x+s*.3)} ${f(y-s*1.7)} ${f(x+s)} ${f(y-s*1.2)} ${f(x+s)} ${y}Z`;return `<path class="${c?'f-ochre':'bg'}" d="${d}"/><path class="hf" d="${d}" opacity=".5" stroke="none"/><path d="${d}"/><path class="t" d="M${x} ${f(y-s*1.7)}v${f(-s*.3)}"/>`}
function house(x,y,w,h,c,fl=2){let s=`<path class="${c?(rnd()<.5?'f-clay':'f-bone2'):'bg'}" d="M${x} ${y}V${f(y-h)}H${f(x+w)}V${y}Z"/><path d="M${x} ${y}V${f(y-h)}H${f(x+w)}V${y}Z"/><path class="${c?'f-dark':'bg'}" d="M${f(x-4)} ${f(y-h)}L${f(x+w/2)} ${f(y-h-w*.35)}L${f(x+w+4)} ${f(y-h)}Z"/><path d="M${f(x-4)} ${f(y-h)}L${f(x+w/2)} ${f(y-h-w*.35)}L${f(x+w+4)} ${f(y-h)}Z"/>`;
  for(let r=0;r<fl;r++)for(let k=0;k<3;k++){const wx=x+w*(.12+k*.3),wy=y-h+h*(.12+r*(.8/fl));s+=`<path class="${c?'f-gold':'bg'}" d="M${f(wx)} ${f(wy)}h${f(w*.16)}v${f(h*.22/fl*1.6)}h${f(-w*.16)}Z" opacity=".9"/><path class="t" d="M${f(wx)} ${f(wy)}h${f(w*.16)}v${f(h*.22/fl*1.6)}h${f(-w*.16)}Z"/>`}return s}

function hero(c){seed=11;let s='';
  s+=hill(-40,640,600,480,.25,c?'f-teal':'')+hill(940,1700,600,470,.25,c?'f-teal':'');
  s+=`<path class="ns" d="${wave(-20,1620,600,3)}" stroke-width="2.2"/>`;
  s+=road(800,600,900,18,520,c)+oak(250,720,300,c);
  for(let i=0;i<14;i++){const x=rnd()*1600,y=620+rnd()*260;if(Math.abs(x-800)<(y-600)*1.7+20)continue;s+=grass(x,y,6+((y-600)/300)*14)}
  return s}
function later(c){seed=23;let s='';s+=hill(-60,700,640,470,.22,'')+hill(900,1700,640,480,.22,'');
  s+=`<path class="ns" d="${wave(-20,1620,640,3)}" stroke-width="2"/>`;return s}
function lab(c){seed=37;let s='';s+=hill(-60,600,620,480,.3,c?'f-teal':'')+hill(900,1700,620,430,.3,c?'f-teal':'')+forest(560,900,620,c)+hut(1180,560,110,c)+oak(220,640,220,c)+poplar(1450,620,180,c)+cloud(420,200,28,c)+birds(980,160,4);
  s+=`<path class="ns" d="${wave(-20,1620,620,3)}" stroke-width="2"/>`;return s}
function parade(c,W){seed=51;let s='';const X=W||4800;
  s+=hill(-60,1300,600,420,.3,c?'f-teal':'')+hill(900,2600,600,380,.3,c?'f-teal':'')+hill(2300,3800,600,440,.3,c?'f-teal':'')+hill(3500,4900,600,470,.3,c?'f-teal':'');
  
  s+=oak(1200,612,220,c)+hut(2100,600,100,c);
  /* античность: колонны */
  for(let i=0;i<5;i++){const x=2500+i*70;s+=`<path class="${c?'f-bone2':'bg'}" d="M${x} 600V470h26V600Z"/><path d="M${x} 600V470h26V600ZM${x-6} 470h38M${x-6} 462h38"/><path class="t" d="M${x+8} 476V596M${x+17} 476V596"/>`}
  s+=`<path class="${c?'f-bone2':'bg'}" d="M2486 462L2700 410L2914 462Z"/><path d="M2486 462L2700 410L2914 462Z"/>`;
  /* город */
  let x=3300;while(x<X-80){const w=90+rnd()*80,h=120+rnd()*140;s+=house(x,600,w,h,c,h>200?3:2);x+=w+20+rnd()*30}
  s+=`<path class="ns" d="${wave(-20,X+20,600,2,60)}" stroke-width="2"/>`;return s}
function day(c){seed=61;let s='';s+=hill(-60,700,600,490,.2,'')+hill(800,1700,600,470,.2,'')+hut(1250,600,110,c);
  s+=`<path class="ns" d="${wave(-20,1620,600,2)}" stroke-width="2"/>`;return s}
function nag(c){seed=71;let s='';
  s+=`<path class="${c?'f-indigo':'bg'}" d="M0 0H1600V640H0Z" stroke="none" opacity=".6"/>`;
  for(let i=0;i<7;i++){const x=800-115-22+(i-3)*230;s+=`<path class="${c?'f-bone2':'bg'}" d="M${x} 640V250h44V640Z"/><path class="hf" d="M${x+26} 640V250h18V640Z" opacity=".6" stroke="none"/><path d="M${x} 640V250h44V640ZM${x-12} 250h68v-16h-68ZM${x-10} 640h64v12h-64Z"/>`;
    if(i<6&&i!==3)s+=`<path d="M${x+44} 330C${x+80} 250 ${x+190} 250 ${x+230} 330" />`}
  
  s+=`<path class="ns" d="M0 640H1600" stroke-width="2"/>`;
  return s}
const K={hero,later,lab,parade,day,nag};
return function(kind,color,W){return (K[kind]||hero)(color,W)}})();

/* «Далеко собрались?» v10 — движок сцен, колесо-проводник с морфингом, разрывы, повозки, звук */
(function(){
const $=id=>document.getElementById(id),$$=(s,r=document)=>[...r.querySelectorAll(s)];
const html=document.documentElement;
const reduce=matchMedia('(prefers-reduced-motion: reduce)').matches;
const clamp01=x=>x<0?0:x>1?1:x,lerp=(a,b,t)=>a+(b-a)*t;
const sm=(a,b,x)=>{const t=clamp01((x-a)/(b-a));return t*t*(3-2*t)};
let W=innerWidth,H=innerHeight;
const G={userDeg:0,snap:false,fast:false};

/* ══ ЗВУК: всё синтезируется на месте, без файлов ══ */
const SND={on:true,ctx:null,last:{},
  init(){if(this.ctx)return;try{const C=window.AudioContext||window.webkitAudioContext;if(!C)return;const c=this.ctx=new C();
    const lp=c.createBiquadFilter();lp.type='lowpass';lp.frequency.value=6500;const comp=c.createDynamicsCompressor();comp.threshold.value=-18;comp.ratio.value=3;
    this.out=c.createGain();this.out.gain.value=.3;this.out.connect(lp);lp.connect(comp);comp.connect(c.destination);
    const len=c.sampleRate*1.8,ir=c.createBuffer(2,len,c.sampleRate);for(let ch=0;ch<2;ch++){const d=ir.getChannelData(ch);for(let i=0;i<len;i++)d[i]=(Math.random()*2-1)*Math.pow(1-i/len,3.2)}
    const cv=c.createConvolver();cv.buffer=ir;this.rev=c.createGain();this.rev.gain.value=.12;this.rev.connect(cv);cv.connect(lp);
    const b=this.noise=c.createBuffer(1,c.sampleRate*2,c.sampleRate),d=b.getChannelData(0);for(let i=0;i<d.length;i++)d[i]=Math.random()*2-1;
    const ks=(f,dur,damp,soft)=>{const sr=c.sampleRate,N=Math.round(sr/f),L=Math.round(sr*dur),buf=c.createBuffer(1,L,sr),y=buf.getChannelData(0);let prev=0;for(let i=0;i<N;i++){const r=Math.random()*2-1;prev=prev*soft+r*(1-soft);y[i]=prev}
      for(let i=N;i<L;i++)y[i]=damp*.5*(y[i-N]+y[i-N-1]);let m=0;for(let i=0;i<L;i++)m=Math.max(m,Math.abs(y[i]));for(let i=0;i<L;i++)y[i]/=m||1;return buf};
    this.KS={wood:ks(330,.35,.93,.55),thump:ks(110,.5,.975,.75),pluck:ks(220,2.2,.997,.45),tick:ks(1200,.08,.9,.3)}}catch(e){this.ctx=null}},
  ksPlay(name,t,rate=1,v=.5,lp=4000){const c=this.ctx,s=c.createBufferSource(),f=c.createBiquadFilter(),g=c.createGain();s.buffer=this.KS[name];s.playbackRate.value=rate*(1+(Math.random()-.5)*.03);f.type='lowpass';f.frequency.value=lp;g.gain.value=v;s.connect(f);f.connect(g);this.send(g);s.start(t)},
  send(node){node.connect(this.out);node.connect(this.rev)},
  mallet(f,t,v=1,dur=.45,bright=.12){const c=this.ctx,g=c.createGain();this.send(g);g.gain.value=v;
    const o=c.createOscillator(),og=c.createGain();o.type='sine';o.frequency.value=f;og.gain.setValueAtTime(.0001,t);og.gain.exponentialRampToValueAtTime(.32,t+.004);og.gain.exponentialRampToValueAtTime(.0001,t+dur);o.connect(og);og.connect(g);o.start(t);o.stop(t+dur+.05);
    const o2=c.createOscillator(),g2=c.createGain();o2.type='sine';o2.frequency.value=f*3.98;g2.gain.setValueAtTime(.0001,t);g2.gain.exponentialRampToValueAtTime(bright,t+.002);g2.gain.exponentialRampToValueAtTime(.0001,t+dur*.18);o2.connect(g2);g2.connect(g);o2.start(t);o2.stop(t+dur*.2+.05)},
  soft(f,t,v,dur,f2,type='sine'){const c=this.ctx,o=c.createOscillator(),g=c.createGain();o.type=type;o.frequency.setValueAtTime(f,t);if(f2)o.frequency.exponentialRampToValueAtTime(f2,t+dur*.8);g.gain.setValueAtTime(.0001,t);g.gain.exponentialRampToValueAtTime(v,t+.012);g.gain.exponentialRampToValueAtTime(.0001,t+dur);o.connect(g);this.send(g);o.start(t);o.stop(t+dur+.05)},
  air(t,dur,v,f0,f1,q=.8){const c=this.ctx,s=c.createBufferSource(),fl=c.createBiquadFilter(),g=c.createGain();s.buffer=this.noise;s.loop=true;fl.type='bandpass';fl.Q.value=q;fl.frequency.setValueAtTime(f0,t);fl.frequency.exponentialRampToValueAtTime(f1,t+dur);
    g.gain.setValueAtTime(.0001,t);g.gain.exponentialRampToValueAtTime(v,t+dur*.35);g.gain.exponentialRampToValueAtTime(.0001,t+dur);s.connect(fl);fl.connect(g);this.send(g);s.start(t,Math.random());s.stop(t+dur+.05)},
  note:0,
  ok(name,gap=0){if(!this.on||!this.ctx||this.ctx.state!=='running')return false;const n=performance.now();if(gap&&this.last[name]&&n-this.last[name]<gap)return false;this.last[name]=n;return true},
  env(g,t,a,peak,dec){g.gain.setValueAtTime(0.0001,t);g.gain.exponentialRampToValueAtTime(peak,t+a);g.gain.exponentialRampToValueAtTime(0.0001,t+a+dec)},
  osc(type,f,t,dur,peak,f2,dest){const c=this.ctx,o=c.createOscillator(),g=c.createGain();o.type=type;o.frequency.setValueAtTime(f,t);if(f2)o.frequency.exponentialRampToValueAtTime(f2,t+dur);this.env(g,t,.005,peak,dur);o.connect(g);g.connect(dest||this.out);o.start(t);o.stop(t+dur+.05);return o},
  nz(t,dur,peak,ftype,f,q,dest){const c=this.ctx,s=c.createBufferSource(),fl=c.createBiquadFilter(),g=c.createGain();s.buffer=this.noise;s.loop=true;fl.type=ftype;fl.frequency.value=f;fl.Q.value=q||1;this.env(g,t,.004,peak,dur);s.connect(fl);fl.connect(g);g.connect(dest||this.out);s.start(t,Math.random());s.stop(t+dur+.05);return {s,fl,g}},
  play(name,v=1){if(!this.ok(name,name==='scribble'?55:name==='plank'?35:120))return;const c=this.ctx,t=c.currentTime;const F=this.fx[name];if(F)F.call(this,t,v)},
  proj:null,
  projector(on){if(!this.ctx||this.ctx.state!=='running'||!this.on)on=false;
    if(on&&!this.proj){const c=this.ctx,g=c.createGain();g.gain.value=0;g.connect(this.out);g.gain.linearRampToValueAtTime(1,c.currentTime+.3);
      const hum=c.createOscillator(),hf=c.createBiquadFilter(),hg=c.createGain();hum.type='sawtooth';hum.frequency.value=47;hf.type='lowpass';hf.frequency.value=180;hg.gain.value=.006;hum.connect(hf);hf.connect(hg);hg.connect(g);hum.start();
      let next=c.currentTime+.05;const tick=()=>{while(next<c.currentTime+.3){this.osc('sine',1800+Math.random()*200,next,.006,.006,null,g);next+=1/18}};tick();
      this.proj={g,hum,iv:setInterval(tick,120)}}
    else if(!on&&this.proj){const P=this.proj,c=this.ctx;this.proj=null;clearInterval(P.iv);P.g.gain.linearRampToValueAtTime(0,c.currentTime+.25);setTimeout(()=>{try{P.hum.stop()}catch(e){}},400)}},
  fx:{
    wood(t,v){this.ksPlay('wood',t,1.4,.32*v,3200)},
    knock(t,v){this.ksPlay('wood',t,1,.36*v,2400)},
    click(t,v){this.ksPlay('wood',t,1.8,.24*v,3600)},
    plank(t,v){v=Math.max(.3,Math.min(1,v));this.ksPlay('thump',t,.9+Math.random()*.25,.32*v,900);this.ksPlay('wood',t+.004,.7+Math.random()*.2,.1*v,1400);if(Math.random()<.6)this.air(t,.08,.012*v,2600,1800,1.5)},
    roll(t){for(let i=0;i<5;i++)this.fx.plank.call(this,t+i*.16+Math.random()*.03,.8-i*.12)},
    steps(t){for(let i=0;i<6;i++)this.ksPlay('thump',t+i*.18,.75+Math.random()*.15,.18,500)},
    scribble(t){this.air(t,.05+Math.random()*.04,.012,3400+Math.random()*1200,2600,2.5)},
    tear(t){this.air(t,.45,.05,700,3600,.6);for(let i=0;i<8;i++)this.air(t+i*.05,.035,.018,2800+Math.random()*2000,2200,2)},
    moo(t){const c=this.ctx,o=c.createOscillator(),f=c.createBiquadFilter(),g=c.createGain(),v=c.createOscillator(),vg=c.createGain();
      o.type='sawtooth';o.frequency.setValueAtTime(120,t);o.frequency.linearRampToValueAtTime(138,t+.3);o.frequency.linearRampToValueAtTime(98,t+1.05);v.frequency.value=5;vg.gain.value=2.5;v.connect(vg);vg.connect(o.frequency);
      f.type='lowpass';f.frequency.setValueAtTime(380,t);f.frequency.linearRampToValueAtTime(820,t+.35);f.frequency.linearRampToValueAtTime(360,t+1.05);f.Q.value=5;
      g.gain.setValueAtTime(.0001,t);g.gain.exponentialRampToValueAtTime(.13,t+.18);g.gain.setValueAtTime(.12,t+.8);g.gain.exponentialRampToValueAtTime(.0001,t+1.15);o.connect(f);f.connect(g);this.send(g);[o,v].forEach(x=>{x.start(t);x.stop(t+1.2)})},
    clop(t){for(let i=0;i<8;i++)this.ksPlay('wood',t+i*.14+(i%2?.04:0),i%2?1.6:2,.18,3000)},
    klaxon(t){[[0,330],[.26,262]].forEach(([d,f])=>{this.soft(f*.5,t+d,.06,.22,f*.55,'triangle');this.soft(f,t+d,.035,.22,f*1.06,'triangle')})},
    piano(t){[[659,0],[587,.2]].forEach(([f,d])=>this.ksPlay('pluck',t+d,f/220,.22,3000));[220,330,440,523].forEach((f,i)=>this.ksPlay('pluck',t+.42+i*.02,f/220,.16,2600))},
    squeak(t){this.soft(900,t,.025,.14,1300);this.soft(1000,t+.18,.02,.14,1500)},
    whoosh(t){this.air(t,.32,.035,300,2000,.7)},
    bubble(t){this.soft(260,t,.07,.14,720);this.soft(360,t+.15,.05,.12,900)},
    gong(t){[[147,.1,3.4],[220,.06,2.8],[294,.04,2.2]].forEach(([f,a,d])=>this.soft(f,t,a,d));this.ksPlay('pluck',t,147/220,.12,1800)},
    rewind(t){for(let i=0;i<18;i++)this.ksPlay('tick',t+i*.09,.9+(i%3)*.1,.08,3000);this.air(t,1.6,.02,3000,400,.5)}
  }
};
const play=(n,v)=>SND.play(n,v);
function gesture(){SND.init();if(SND.ctx&&SND.ctx.state==='suspended')SND.ctx.resume()}
addEventListener('pointerdown',gesture,{passive:true});addEventListener('keydown',gesture);
const sbtn=$('sndBtn');
if(sbtn){const sync=()=>{sbtn.setAttribute('aria-pressed',SND.on);sbtn.querySelector('.st-l').textContent=SND.on?'звук вкл':'звук выкл'};
  try{if(localStorage.getItem('koleso-snd')==='0')SND.on=false}catch(e){}sync();
  sbtn.addEventListener('click',()=>{gesture();SND.on=!SND.on;try{localStorage.setItem('koleso-snd',SND.on?'1':'0')}catch(e){}sync();if(SND.on)setTimeout(()=>play('click'),30)})}
document.addEventListener('click',e=>{const b=e.target.closest('button,a');if(b&&b!==sbtn&&!b.classList.contains('part')&&!b.classList.contains('o-opt'))play('click')});

