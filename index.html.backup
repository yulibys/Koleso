    <path class="t road-dash" d="M-40 288H840" stroke-dasharray="26 18"/>
    <path class="t" d="M60 280h10M300 282h6M520 279h12M700 283h8M30 296h14M420 298h9"/>
   </g>
   <g class="rig">
    <g class="p p-ox" transform="translate(520 144)"><use href="#tOx"/></g>
    <g class="p p-body">
     <path d="M420 192L676 178M670 166L684 196"/>
